using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.IO;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;
using MQTTnet;
using MQTTnet.Client;
using MQTTnet.Client.Options;
// Esta es la librería esencial para desarmar el JSON que viene del Servidor
using Newtonsoft.Json;

namespace Tarea_2._1
{
    public partial class LoteTech : Form
    {
        // Esta estructura es idéntica a la del Servidor para poder leer el JSON correctamente
        public class SorteoData
        {
            public int numero1 { get; set; }
            public int numero2 { get; set; }
            public int numero3 { get; set; }
        }

        private IMqttClient mqttClient;
        private string miClienteId;

        public LoteTech()
        {
            InitializeComponent();
            // Creamos un ID único para el cliente para que el broker no se confunda con el servidor
            miClienteId = "LoteTech_Client_" + Guid.NewGuid().ToString().Substring(0, 5);
            ConectarMQTT();
        }

        private async void ConectarMQTT()
        {
            try
            {
                var factory = new MqttFactory();
                mqttClient = factory.CreateMqttClient();

                var options = new MqttClientOptionsBuilder()
                    .WithTcpServer("broker.hivemq.com", 1883)
                    .WithClientId(miClienteId)
                    .WithCleanSession()
                    .Build();

                // Aquí se programa qué hacer cuando llega un mensaje desde el servidor MQTT
                mqttClient.UseApplicationMessageReceivedHandler(e =>
                {
                string topico = e.ApplicationMessage.Topic;
                string payload = Encoding.UTF8.GetString(e.ApplicationMessage.Payload);

                // Si el mensaje viene del canal del sorteo
                if (topico == "granpremio/sorteo")
                {
                    // Convertimos el texto JSON de vuelta a números legibles por C#
                    var datosSorteo = JsonConvert.DeserializeObject<SorteoData>(payload);

                                         // Usamos Invoke para poder escribir de manera segura en las cajas de la pantalla
                                         this.Invoke((Action)(() => {
                                             textPrimera.Text = datosSorteo.numero1.ToString();
                                             textSegunda.Text = datosSorteo.numero2.ToString();
                                             textTercera.Text = datosSorteo.numero3.ToString();
                                         }));
                                     }
                                     });

                                     await mqttClient.ConnectAsync(options);
                                     MessageBox.Show("¡Cliente Conectado a MQTT con éxito!");
                                 }
                                 catch (Exception ex)
                                 {
                                     MessageBox.Show("Error de conexión en el Cliente:\n" + ex.Message);
                                 }
                             }
                         }
                    }
                   